{
  "expo": {
    "name": "Peppe Manager",
    "slug": "peppe-manager-mobile",
    "owner": "fha_s",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "peppe",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.peppemanager.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.peppemanager.app"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Peppe usa los datos de Apple Health que tú autorices para interpretar recuperación, composición corporal y contexto de rendimiento.",
          "NSHealthUpdateUsageDescription": "Peppe sólo escribirá datos en Apple Health si en el futuro tú activas explícitamente esa función.",
          "background": false
        }
      ],
      "./plugins/withPersonalTeamIos.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "19bc5953-f9b5-44b3-b9b6-619421d95476"
      }
    }
  }
}
